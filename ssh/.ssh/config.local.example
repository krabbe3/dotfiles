# Copy to config.local (untracked) and fill in real values.

# cluster login node
Host hpc
  HostName <hpc-login-host>
  User <user>
  ForwardAgent yes

# compute node, jumped from hpc
Host m69
  HostName <compute-host>
  User <user>
  ProxyJump hpc
  ForwardAgent yes
  ForwardX11 yes
  # OpenWebUI forwarding LLM Web Interface
  LocalForward 5398 localhost:5398
  LocalForward 3098 localhost:3098
  # Lichtblick Forward for ROS Visualization
  LocalForward 8765 localhost:8765

# admin account for data movement
Host ems-admin
    HostName <hpc-login-host>
    User <admin-user>

# llm tunnel
Host llm-tunnel
    HostName <compute-host>
    User <user>
    ProxyJump hpc
    ExitOnForwardFailure yes
    ServerAliveInterval 30
    ServerAliveCountMax 3

# self-hosted gitlab
Host <gitlab-host>
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
