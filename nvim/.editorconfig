root = true

[*]
charset = utf-8
insert_final_newline = false
end_of_line = lf
trim_trailing_whitespace = true

[*.lua]
indent_style = space
indent_size = 4

[*.{py,ipynb}]
indent_style = space
indent_size = 4

[*.{md,markdown}]
indent_style = space
indent_size = 2
# Prevents stripping two trailing spaces used for Markdown line breaks (<br>)
trim_trailing_whitespace = false

[*.{tex,ltx,sty,cls,bib}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true