#!/usr/bin/env bash
set -euo pipefail

GIT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$GIT_ROOT" ]; then
  echo "Error: Not in a git repo."
  exit 1
fi

PROJECT_NAME="$(basename "$GIT_ROOT")"
ACTIVE_SYMLINK="/tmp/.dune-clones/${PROJECT_NAME}-active"

if [ ! -L "$ACTIVE_SYMLINK" ]; then
  echo "No active Dune sandbox found for $PROJECT_NAME."
  exit 1
fi

git fetch "$ACTIVE_SYMLINK" HEAD:dune/agent-latest --force
echo "==> Synced latest sandbox commits into branch: dune/agent-latest"
echo "==> Run: git merge dune/agent-latest"
