#!/usr/bin/env bash
set -euo pipefail

# Resolve real path even if invoked via symlink
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
DUNE_BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

usage() {
  cat <<EOF
Usage: dune <command> [options]

Available commands:
  mentat       Launch AI sandbox on the current project
               Default (live): agent edits your files directly, .git is read-only
               Options:
                 -i, --isolated                 Shallow clone instead; agent commits go to dune/agent-<time>
                 -g, --gitlab                   Give the agent the GitLab token for this session
                 --rebuild-env                  macOS: rebuild the Linux copy of the active env
                 -p, --py, --python <version>   Python version (default: active Conda env, else 3.10)
                 -r, --rebuild                  Force clean rebuild (--no-cache)
  spice        (isolated mode) Fetch sandbox commits to dune/agent-<time> (also recovers kept clones)
  snap         Snapshot all files (host side, refs/dune/...); -l lists snapshots
  diff         Show changes since a snapshot (default: start of last session); -t opens nvim
  undo         Restore files to a snapshot (default: newest one that differs)
  ghola        Resurrect workspace layout (editor/git/explorer) via tmuxinator
               Usage:
                 dune ghola <template> [session_name] [conda_env]
                 dune ghola -k [session_name]
  help         Show this message
EOF
  exit 0
}

if [[ $# -eq 0 ]]; then
  usage
fi

COMMAND="$1"
shift

case "$COMMAND" in
  mentat)
    exec "$DUNE_BIN_DIR/dune-mentat" "$@"
    ;;
  spice)
    exec "$DUNE_BIN_DIR/dune-spice" "$@"
    ;;
  ghola)
    exec "$DUNE_BIN_DIR/dune-ghola" "$@"
    ;;
  snap|diff|undo)
    exec "$DUNE_BIN_DIR/dune-snap" "$COMMAND" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Error: Unknown command '$COMMAND'" >&2
    usage
    ;;
esac
