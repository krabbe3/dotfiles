#!/usr/bin/env bash
set -euo pipefail

# 1. Resolve DUNE_DIR dynamically relative to this script
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
DUNE_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
SANDBOX_DIR="$DUNE_DIR/sandboxes/mentat"

TARGET_DIR="$(pwd)"
PROJECT_NAME="$(basename "$TARGET_DIR")"

# 2. Parse flags: --py <ver> and --rebuild
SELECTED_PY=""
FORCE_REBUILD=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -p|--py|--python)
      SELECTED_PY="$2"
      shift 2
      ;;
    -r|--rebuild)
      FORCE_REBUILD=true
      shift
      ;;
    *)
      break
      ;;
  esac
done

# Auto-detect Python version from active Conda environment if not explicitly set via flag
if [[ -z "$SELECTED_PY" && -n "${CONDA_PREFIX:-}" ]]; then
  DETECTED_PY="$("$CONDA_PREFIX/bin/python" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null || true)"
  if [[ -n "$DETECTED_PY" ]]; then
    echo "==> Detected active Conda env (${CONDA_DEFAULT_ENV:-custom}) with Python $DETECTED_PY"
    SELECTED_PY="$DETECTED_PY"
  fi
fi

export PYTHON_VERSION="${SELECTED_PY:-3.10}"
echo "==> Runtime: Python $PYTHON_VERSION"

# 3. Isolation: Ephemeral Shallow Clone (Hides History, Allows Commits)
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  IS_GIT=true
  GIT_ROOT="$(git rev-parse --show-toplevel)"
  PROJECT_NAME="$(basename "$GIT_ROOT")"
  TIMESTAMP="$(date +%Y%m%d_%H%M%S)"
  BRANCH_NAME="dune/agent-latest"
  CLONE_BASE_DIR="/tmp/.dune-clones"
  CLONE_DIR="${CLONE_BASE_DIR}/${PROJECT_NAME}-${TIMESTAMP}"
  ACTIVE_SYMLINK="${CLONE_BASE_DIR}/${PROJECT_NAME}-active"

  if ! git -C "$GIT_ROOT" diff --quiet || ! git -C "$GIT_ROOT" diff --cached --quiet; then
    echo "==> Warning: Working tree has uncommitted edits. Only committed HEAD is cloned."
  fi

  mkdir -p "$CLONE_BASE_DIR"

  echo "==> Git repo detected at: $GIT_ROOT"
  echo "==> Creating isolated shallow clone at: $CLONE_DIR"

  git clone --depth 1 "file://$GIT_ROOT" "$CLONE_DIR" >/dev/null 2>&1
  git -C "$CLONE_DIR" remote remove origin >/dev/null 2>&1 || true

  # Maintain a stable active symlink for live syncing from host
  ln -sfn "$CLONE_DIR" "$ACTIVE_SYMLINK"

  RUN_DIR="$CLONE_DIR"

  # 4. Handle .env files
  if [[ -f "$TARGET_DIR/.env" ]]; then
    echo "==> Detected project .env: injecting into sandbox"
    export PROJECT_ENV_FILE="$TARGET_DIR/.env"
    cp "$TARGET_DIR/.env" "$CLONE_DIR/.env"
  elif [[ -f "$SANDBOX_DIR/.env" ]]; then
    echo "==> Using default sandbox .env"
    export PROJECT_ENV_FILE="/dev/null"
    cp "$SANDBOX_DIR/.env" "$CLONE_DIR/.env"
  else
    export PROJECT_ENV_FILE="/dev/null"
  fi

  # Trap cleanup on exit, interrupt, or error
  cleanup() {
    echo ""
    echo "==> Cleaning up sandbox clone..."

    if [ -d "$CLONE_DIR" ]; then
      # 1. Check for uncommitted work and preserve it automatically
      if [ -n "$(git -C "$CLONE_DIR" status --porcelain 2>/dev/null)" ]; then
        echo "==> Detected uncommitted changes in sandbox: auto-committing..."
        git -C "$CLONE_DIR" add -A
        git -C "$CLONE_DIR" commit -m "dune(auto): snapshot of uncommitted agent work on exit" >/dev/null 2>&1 || true
      fi

      SANDBOX_HEAD="$(git -C "$CLONE_DIR" rev-parse HEAD 2>/dev/null || true)"
      HOST_HEAD="$(git -C "$GIT_ROOT" rev-parse HEAD 2>/dev/null || true)"

      if [ -n "$SANDBOX_HEAD" ] && [ "$SANDBOX_HEAD" != "$HOST_HEAD" ]; then
        echo "==> Ingesting sandbox commits into branch: $BRANCH_NAME"
        git -C "$GIT_ROOT" fetch "$CLONE_DIR" "HEAD:${BRANCH_NAME}" --force >/dev/null 2>&1 || true
        echo "==> Changes preserved on host branch: $BRANCH_NAME"
        echo "==> To review:   git diff HEAD..$BRANCH_NAME"
        echo "==> To merge:    git merge $BRANCH_NAME"
        echo "==> To discard:  git branch -D $BRANCH_NAME"
      else
        echo "==> No new commits detected in sandbox."
      fi

      rm -f "$ACTIVE_SYMLINK" 2>/dev/null || true
      rm -rf "$CLONE_DIR" 2>/dev/null || true
    fi
    return 0
  }
  trap cleanup EXIT INT TERM
else
  IS_GIT=false
  RUN_DIR="$TARGET_DIR"

  if [[ -f "$TARGET_DIR/.env" ]]; then
    export PROJECT_ENV_FILE="$TARGET_DIR/.env"
  elif [[ -f "$SANDBOX_DIR/.env" ]]; then
    export PROJECT_ENV_FILE="$SANDBOX_DIR/.env"
  else
    export PROJECT_ENV_FILE="/dev/null"
  fi
fi

# 5. Dynamic Data Mounts via DUNE_DATA_MOUNTS
EXTRA_VOLUMES=()
PROJECT_DATA_MOUNTS=""

if [[ -f "$TARGET_DIR/.env" ]]; then
  PROJECT_DATA_MOUNTS="$(grep -E '^DUNE_DATA_MOUNTS=' "$TARGET_DIR/.env" | cut -d '=' -f2- | tr -d '\r"' || true)"
fi

if [[ -z "$PROJECT_DATA_MOUNTS" && -f "$SANDBOX_DIR/.env" ]]; then
  PROJECT_DATA_MOUNTS="$(grep -E '^DUNE_DATA_MOUNTS=' "$SANDBOX_DIR/.env" | cut -d '=' -f2- | tr -d '\r"' || true)"
fi

if [[ -n "$PROJECT_DATA_MOUNTS" ]]; then
  IFS=',' read -ra MOUNT_ENTRIES <<< "$PROJECT_DATA_MOUNTS"
  for entry in "${MOUNT_ENTRIES[@]}"; do
    entry="$(echo "$entry" | xargs)"
    if [[ -n "$entry" ]]; then
      # Same-path mapping fallback: host_path:host_path:ro
      if [[ "$entry" != *:* ]]; then
        entry="$entry:$entry:ro"
      fi
      echo "==> Mounting external data volume (same-path): $entry"
      EXTRA_VOLUMES+=(-v "$entry")
    fi
  done
fi

# 6. Active Host Conda Environment Direct Passthrough
CONTAINER_CONDA_PATH=""
if [[ -n "${CONDA_PREFIX:-}" && -d "$CONDA_PREFIX" ]]; then
  echo "==> Passing active host Conda env (${CONDA_DEFAULT_ENV:-custom}): $CONDA_PREFIX"
  EXTRA_VOLUMES+=(-v "$CONDA_PREFIX:$CONDA_PREFIX:ro")
  CONTAINER_CONDA_PATH="$CONDA_PREFIX/bin"
fi

# 7. Dynamic Port Selection for Plannotator
FOUND_PORT=$(python3 -c 'import socket; print(next(p for p in range(19400, 19600) if socket.socket().connect_ex(("127.0.0.1", p)) != 0))' 2>/dev/null || echo "19400")
export PLANNOTATOR_PORT="$FOUND_PORT"
export PLANNOTATOR_REMOTE=1
echo "==> Plannotator endpoint assigned to host port: $PLANNOTATOR_PORT"

export TARGET_PROJECT="$RUN_DIR"
export SANDBOX_NAME="${PROJECT_NAME}-agent"
cd "$SANDBOX_DIR"

mkdir -p "$DUNE_DIR/data/pip-cache" \
         "$DUNE_DIR/data/nvim/share" \
         "$DUNE_DIR/data/nvim/state"

# 8. Build Python image on demand or on forced rebuild
if [ "$FORCE_REBUILD" = true ]; then
  echo "==> Rebuild requested. Building dune-python:${PYTHON_VERSION} (clean)..."
  DOCKER_BUILDKIT=1 docker compose build --no-cache dev
elif ! docker image inspect "dune-python:${PYTHON_VERSION}" >/dev/null 2>&1; then
  echo "==> Image dune-python:${PYTHON_VERSION} not found locally. Building..."
  DOCKER_BUILDKIT=1 docker compose build dev
fi

echo "==> Spawning Dune sandbox for: $RUN_DIR"
if [ "${IS_GIT:-false}" = true ]; then
  echo "==> Live sync available from another terminal:"
  echo "    dune spice"
fi

# 9. Launch container, prioritize Conda binaries, then start interactive zsh
DOCKER_BUILDKIT=1 docker compose run "${EXTRA_VOLUMES[@]}" --service-ports --rm dev /bin/zsh -c '
  # Conda-Binaries im Container aktivieren falls übergeben
  if [ -n "'"$CONTAINER_CONDA_PATH"'" ] && [ -d "'"$CONTAINER_CONDA_PATH"'" ]; then
    export PATH="'"$CONTAINER_CONDA_PATH"':$PATH"
    echo "==> Active environment Python: $(which python3)"
  fi

  exec /bin/zsh
'
