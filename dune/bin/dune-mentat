#!/usr/bin/env bash
set -euo pipefail

# 1. Resolve DUNE_DIR dynamically relative to this script
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
DUNE_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
SANDBOX_DIR="$DUNE_DIR/sandboxes/mentat"

TARGET_DIR="$(pwd -P)"
PROJECT_NAME="$(basename "$TARGET_DIR")"

# 2. Parse flags: --py <ver>, --rebuild, --isolated
SELECTED_PY=""
FORCE_REBUILD=false
ISOLATED=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -p|--py|--python)
      SELECTED_PY="$2"
      shift 2
      ;;
    -r|--rebuild)
      FORCE_REBUILD=true
      shift
      ;;
    -i|--isolated)
      ISOLATED=true
      shift
      ;;
    *)
      break
      ;;
  esac
done

# Active host Python env: a venv wins over the Conda env it may be built on
HOST_ENV="${VIRTUAL_ENV:-${CONDA_PREFIX:-}}"
HOST_ENV_PY=""
ENV_VER="" ENV_PREFIX="" ENV_BASE="" ENV_SITE=""
if [[ -n "$HOST_ENV" && -x "$HOST_ENV/bin/python" ]]; then
  HOST_ENV_PY="$HOST_ENV/bin/python"
  # version, prefix, base prefix, site-packages dirs (one per line)
  ENV_INFO="$("$HOST_ENV_PY" -c '
import sys, sysconfig
print("%d.%d" % sys.version_info[:2]); print(sys.prefix); print(sys.base_prefix)
print(":".join(dict.fromkeys([sysconfig.get_path("purelib"), sysconfig.get_path("platlib")])))
' 2>/dev/null || true)"
  if [[ -n "$ENV_INFO" ]]; then
    { read -r ENV_VER; read -r ENV_PREFIX; read -r ENV_BASE; read -r ENV_SITE; } <<< "$ENV_INFO"
    echo "==> Detected active Python env: $HOST_ENV (Python $ENV_VER)"
  else
    HOST_ENV_PY=""
  fi
fi

# Python version of the image: -p, else the host env's, else 3.10
export PYTHON_VERSION="${SELECTED_PY:-${ENV_VER:-3.10}}"
echo "==> Runtime: Python $PYTHON_VERSION"

# 3. File ownership: root in the container must map to the host user.
#    True for rootless Docker and for Colima on macOS; rootful Docker on Linux
#    would leave root-owned files in the project.
DOCKER_SECOPTS="$(docker info --format '{{.SecurityOptions}}' 2>/dev/null || true)"
if [[ "$OSTYPE" == "linux"* && -n "$DOCKER_SECOPTS" && "$DOCKER_SECOPTS" != *rootless* ]]; then
  if [[ "${DUNE_ALLOW_ROOTFUL:-0}" != 1 ]]; then
    echo "Error: Docker is not running rootless. The agent would create root-owned files in your project." >&2
    echo "       Use rootless Docker (DOCKER_HOST=unix:///run/user/$(id -u)/docker.sock)," >&2
    echo "       or set DUNE_ALLOW_ROOTFUL=1 to continue anyway." >&2
    exit 1
  fi
  echo "==> Warning: rootful Docker, files created by the agent will be owned by root."
fi

# 4. Workspace: live (default) or isolated shallow clone
EXTRA_VOLUMES=()
IS_GIT=false
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  IS_GIT=true
  GIT_ROOT="$(git rev-parse --show-toplevel)"
  PROJECT_NAME="$(basename "$GIT_ROOT")"
fi

if [[ "$ISOLATED" = true && "$IS_GIT" = true ]]; then
  # Ephemeral shallow clone: agent may commit freely, results land on dune/agent-latest
  DUNE_MODE="isolated"
  TIMESTAMP="$(date +%Y%m%d_%H%M%S)"
  BRANCH_NAME="dune/agent-latest"
  CLONE_BASE_DIR="${DUNE_CLONE_DIR:-$HOME/.cache/dune-clones}"
  CLONE_DIR="${CLONE_BASE_DIR}/${PROJECT_NAME}-${TIMESTAMP}"
  ACTIVE_SYMLINK="${CLONE_BASE_DIR}/${PROJECT_NAME}-active"

  if ! git -C "$GIT_ROOT" diff --quiet || ! git -C "$GIT_ROOT" diff --cached --quiet; then
    echo "==> Warning: Working tree has uncommitted edits. Only committed HEAD is cloned."
  fi

  mkdir -p "$CLONE_BASE_DIR"

  echo "==> Mode: isolated (shallow clone, commits go to $BRANCH_NAME)"
  echo "==> Creating isolated shallow clone at: $CLONE_DIR"

  git clone --depth 1 "file://$GIT_ROOT" "$CLONE_DIR" >/dev/null 2>&1
  git -C "$CLONE_DIR" remote remove origin >/dev/null 2>&1 || true

  # Maintain a stable active symlink for live syncing from host
  ln -sfn "$CLONE_DIR" "$ACTIVE_SYMLINK"

  # Same subdirectory inside the clone as where dune was started
  REL_DIR="${TARGET_DIR#"$GIT_ROOT"}"
  WORK_DIR="$CLONE_DIR$REL_DIR"
  EXTRA_VOLUMES+=(-v "$CLONE_DIR:$CLONE_DIR:rw")

  # Handle .env files
  if [[ -f "$TARGET_DIR/.env" ]]; then
    echo "==> Detected project .env: injecting into sandbox"
    export PROJECT_ENV_FILE="$TARGET_DIR/.env"
    cp "$TARGET_DIR/.env" "$CLONE_DIR/.env"
  elif [[ -f "$SANDBOX_DIR/.env" ]]; then
    echo "==> Using default sandbox .env"
    export PROJECT_ENV_FILE="/dev/null"
    cp "$SANDBOX_DIR/.env" "$CLONE_DIR/.env"
  else
    export PROJECT_ENV_FILE="/dev/null"
  fi
  # Never let the injected .env reach the auto-commit / dune/agent-latest
  if [[ -d "$CLONE_DIR/.git" ]]; then
    printf '.env\n' >> "$CLONE_DIR/.git/info/exclude"
  fi

  # Trap cleanup on exit, interrupt, or error
  cleanup() {
    echo ""
    echo "==> Cleaning up sandbox clone..."

    if [ -d "$CLONE_DIR" ]; then
      # 1. Check for uncommitted work and preserve it automatically
      if [ -n "$(git -C "$CLONE_DIR" status --porcelain 2>/dev/null)" ]; then
        echo "==> Detected uncommitted changes in sandbox: auto-committing..."
        git -C "$CLONE_DIR" add -A
        git -C "$CLONE_DIR" commit -m "dune(auto): snapshot of uncommitted agent work on exit" >/dev/null 2>&1 || true
      fi

      SANDBOX_HEAD="$(git -C "$CLONE_DIR" rev-parse HEAD 2>/dev/null || true)"
      HOST_HEAD="$(git -C "$GIT_ROOT" rev-parse HEAD 2>/dev/null || true)"

      if [ -n "$SANDBOX_HEAD" ] && [ "$SANDBOX_HEAD" != "$HOST_HEAD" ]; then
        echo "==> Ingesting sandbox commits into branch: $BRANCH_NAME"
        git -C "$GIT_ROOT" fetch "$CLONE_DIR" "HEAD:${BRANCH_NAME}" --force >/dev/null 2>&1 || true
        echo "==> Changes preserved on host branch: $BRANCH_NAME"
        echo "==> To review:   git diff HEAD..$BRANCH_NAME"
        echo "==> To merge:    git merge $BRANCH_NAME"
        echo "==> To discard:  git branch -D $BRANCH_NAME"
      else
        echo "==> No new commits detected in sandbox."
      fi

      rm -f "$ACTIVE_SYMLINK" 2>/dev/null || true
      rm -rf "$CLONE_DIR" 2>/dev/null || true
    fi
    return 0
  }
  trap cleanup EXIT INT TERM
else
  # Live: the real project, mounted at the same path as on the host.
  # The agent edits your files directly; .git is read-only, so it can read
  # history (status/diff/log/blame) but cannot commit, branch, stash or add hooks.
  DUNE_MODE="live"
  if [[ "$ISOLATED" = true ]]; then
    echo "==> Warning: --isolated needs a git repo, falling back to live mode."
  fi

  if [[ "$IS_GIT" = true ]]; then
    MOUNT_ROOT="$GIT_ROOT"
    # Common git dir covers .git and, for linked worktrees, the main repo's .git
    GIT_COMMON_DIR="$(cd "$(git rev-parse --git-common-dir)" && pwd -P)"
    EXTRA_VOLUMES+=(-v "$MOUNT_ROOT:$MOUNT_ROOT:rw" -v "$GIT_COMMON_DIR:$GIT_COMMON_DIR:ro")
    echo "==> Mode: live (editing $MOUNT_ROOT directly, .git read-only)"
  else
    MOUNT_ROOT="$TARGET_DIR"
    EXTRA_VOLUMES+=(-v "$MOUNT_ROOT:$MOUNT_ROOT:rw")
    echo "==> Mode: live, no git repo: edits go to $MOUNT_ROOT with no history to fall back on"
  fi
  WORK_DIR="$TARGET_DIR"

  # Host-side snapshots: at start, every few minutes while files change, at exit
  if [[ "$IS_GIT" = true ]]; then
    SNAP="$DUNE_DIR/bin/dune-snap"
    (cd "$GIT_ROOT" && "$SNAP" snap -f -q -m "session start") ||
      echo "==> Warning: could not take the session-start snapshot"
    (
      # kill the running sleep too, so nothing lingers after the session
      trap 'kill "$SLEEP_PID" 2>/dev/null; exit 0' TERM
      cd "$GIT_ROOT"
      while true; do
        sleep "${DUNE_SNAP_INTERVAL:-180}" &
        SLEEP_PID=$!
        wait "$SLEEP_PID"
        "$SNAP" snap -q -m "auto" || true
      done
    ) >/dev/null 2>&1 &
    SNAP_LOOP_PID=$!

    live_cleanup() {
      kill "$SNAP_LOOP_PID" 2>/dev/null || true
      (cd "$GIT_ROOT" && "$SNAP" snap -q -m "session end") || true
      echo ""
      echo "==> Review the session:  dune diff      (in nvim: dune diff -t)"
      echo "==> Undo it:             dune undo $(cd "$GIT_ROOT" && "$SNAP" snap -l | awk '/session start/ {print $2; exit}')"
    }
    trap live_cleanup EXIT
  fi

  if [[ -f "$TARGET_DIR/.env" ]]; then
    export PROJECT_ENV_FILE="$TARGET_DIR/.env"
  else
    export PROJECT_ENV_FILE="/dev/null"
  fi
fi

# 5. Dynamic Data Mounts via DUNE_DATA_MOUNTS
PROJECT_DATA_MOUNTS=""

if [[ -f "$TARGET_DIR/.env" ]]; then
  PROJECT_DATA_MOUNTS="$(grep -E '^DUNE_DATA_MOUNTS=' "$TARGET_DIR/.env" | cut -d '=' -f2- | tr -d '\r"' || true)"
fi

if [[ -z "$PROJECT_DATA_MOUNTS" && -f "$SANDBOX_DIR/.env" ]]; then
  PROJECT_DATA_MOUNTS="$(grep -E '^DUNE_DATA_MOUNTS=' "$SANDBOX_DIR/.env" | cut -d '=' -f2- | tr -d '\r"' || true)"
fi

if [[ -n "$PROJECT_DATA_MOUNTS" ]]; then
  IFS=',' read -ra MOUNT_ENTRIES <<< "$PROJECT_DATA_MOUNTS"
  for entry in "${MOUNT_ENTRIES[@]}"; do
    entry="$(echo "$entry" | xargs)"
    if [[ -n "$entry" ]]; then
      # Same-path mapping fallback: host_path:host_path:ro
      if [[ "$entry" != *:* ]]; then
        entry="$entry:$entry:ro"
      fi
      echo "==> Mounting external data volume (same-path): $entry"
      EXTRA_VOLUMES+=(-v "$entry")
    fi
  done
fi

# 6. Host Python env passthrough (Linux hosts): mounted read-only at the same
#    path; entrypoint.sh adds a session venv on top for the agent's installs
PY_ENV=(-e DUNE_PY_MODE=image)
if [[ -n "$HOST_ENV_PY" ]]; then
  if [[ "$OSTYPE" == "darwin"* ]]; then
    echo "==> macOS host: $HOST_ENV holds macOS binaries and cannot run in the Linux container."
    echo "    Using the image's Python $PYTHON_VERSION instead; install what you need with pip (lost at exit)."
  else
    EXTRA_VOLUMES+=(-v "$ENV_PREFIX:$ENV_PREFIX:ro")
    PY_ENV=(-e DUNE_HOST_BIN="$ENV_PREFIX/bin")
    if [[ "$ENV_PREFIX" == "$ENV_BASE" ]]; then
      # Conda env (or any full Python install): run its own interpreter
      PY_ENV+=(-e DUNE_PY_MODE=env -e DUNE_HOST_PY="$HOST_ENV_PY")
      echo "==> Passing host env read-only: $ENV_PREFIX"
    else
      # venv: its packages are added to the session venv via site dirs
      PY_ENV+=(-e DUNE_HOST_SITE="$ENV_SITE")
      case "$ENV_BASE" in
        /|/usr|/usr/local)
          # system Python base: the container has its own /usr, use the image's
          # Python of the same version with the venv's packages
          PY_ENV+=(-e DUNE_PY_MODE=image)
          if [[ "$PYTHON_VERSION" != "$ENV_VER" ]]; then
            echo "==> Warning: -p $PYTHON_VERSION differs from the venv's Python $ENV_VER; its compiled packages may not load."
          fi
          echo "==> Passing host venv read-only: $ENV_PREFIX (on the image's Python $PYTHON_VERSION)"
          ;;
        *)
          EXTRA_VOLUMES+=(-v "$ENV_BASE:$ENV_BASE:ro")
          PY_ENV+=(-e DUNE_PY_MODE=env -e DUNE_HOST_PY="$HOST_ENV_PY")
          echo "==> Passing host venv read-only: $ENV_PREFIX (base Python: $ENV_BASE)"
          ;;
      esac
    fi
  fi
fi

# Container-side project name: stable and safe for docker names
PROJECT_NAME="$(printf '%s' "$PROJECT_NAME" | tr -cs 'A-Za-z0-9_-' '-' | sed 's/^-*//; s/-*$//')"
export PROJECT_NAME
export SANDBOX_NAME="${PROJECT_NAME}-agent"

cd "$SANDBOX_DIR"

mkdir -p "$DUNE_DIR/data/pip-cache" \
         "$DUNE_DIR/data/nvim/share" \
         "$DUNE_DIR/data/nvim/state"

# 7. Build Python image on demand or on forced rebuild
if [ "$FORCE_REBUILD" = true ]; then
  echo "==> Rebuild requested. Building dune-python:${PYTHON_VERSION} (clean)..."
  DOCKER_BUILDKIT=1 docker compose build --no-cache dev
elif ! docker image inspect "dune-python:${PYTHON_VERSION}" >/dev/null 2>&1; then
  echo "==> Image dune-python:${PYTHON_VERSION} not found locally. Building..."
  DOCKER_BUILDKIT=1 docker compose build dev
fi

echo "==> Spawning Dune sandbox in: $WORK_DIR"
if [ "$DUNE_MODE" = isolated ]; then
  echo "==> Live sync available from another terminal:"
  echo "    dune spice"
fi

# 8. Launch container: entrypoint.sh sets up Python, then starts zsh
DOCKER_BUILDKIT=1 docker compose run "${EXTRA_VOLUMES[@]}" "${PY_ENV[@]}" -w "$WORK_DIR" -e DUNE_MODE="$DUNE_MODE" \
  --service-ports --rm dev /bin/bash /opt/dune/entrypoint.sh
