# syntax=docker/dockerfile:1.4
ARG PYTHON_VERSION=3.10
FROM python:${PYTHON_VERSION}-slim

ENV PIP_BREAK_SYSTEM_PACKAGES=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SHELL=/bin/zsh \
    PYTHON=/usr/local/bin/python3

# System tools and shell requirements
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    zsh \
    stow \
    ca-certificates \
    fzf \
    ripgrep \
    && ln -s /usr/local/bin/python3 /usr/bin/python3 \
    && ln -s /usr/local/bin/python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

# micromamba: builds Linux copies of macOS host envs (sandboxes/mentat/mirror)
ARG MICROMAMBA_VERSION=2.0.5-0
RUN case "$(uname -m)" in x86_64) arch=64 ;; aarch64) arch=aarch64 ;; esac \
    && curl -fsSL -o /usr/local/bin/micromamba \
       "https://github.com/mamba-org/micromamba-releases/releases/download/${MICROMAMBA_VERSION}/micromamba-linux-${arch}" \
    && chmod +x /usr/local/bin/micromamba

# install node.js (NodeSource provides npm bundled with nodejs; separate apt npm is redundant)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# install pi coding agent
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent
# install claude code
RUN curl -fsSL https://claude.ai/install.sh | bash
# install agy
RUN curl -fsSL https://antigravity.google/cli/install.sh | bash

# Set default shell to zsh
RUN chsh -s /bin/zsh root

# Configure Git safe directories & default sandbox agent identity
# projects are mounted at their host path, so trust every directory
RUN git config --global --add safe.directory '*' \
    && git config --global user.name "Dune Agent" \
    && git config --global user.email "agent@dune.local"

# Provision dotfiles and run Neovim/tooling setup
# the 'dotfiles' build context is a shallow clone of the local dotfiles repo,
# made by bin/dune-mentat: committed files only, none of the gitignored ones
USER root
ENV HOME=/root
WORKDIR $HOME/dotfiles

COPY --from=dotfiles . /root/dotfiles
RUN git config --global url."https://github.com/".insteadOf "git@github.com:" \
    && make -C /root/dotfiles docker

# Base installations for mentat
RUN pip install --no-cache-dir black pip-tools ipython

WORKDIR /workspace
CMD ["/bin/zsh"]