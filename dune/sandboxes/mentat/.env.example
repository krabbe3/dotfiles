# ==============================================================================
# Dune AI Sandbox Environment Template
# Copy this file to .env and fill in your personal values:
#   cp .env.example .env
# ==============================================================================

# API Token for AIs
KISSKI_API_KEY=

# University GitLab, for installing private packages (git+https / git+ssh URLs).
# Only passed into the sandbox with 'dune mentat --gitlab'; otherwise the agent
# never sees it. Create a token with the read_repository scope only.
DUNE_GITLAB_HOST=
GITLAB_READ_TOKEN=
